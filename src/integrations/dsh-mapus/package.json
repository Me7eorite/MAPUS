{
  "name": "dsh-mapus",
  "version": "3.0.3",
  "description": "MAPUS x DeepSeek Harness bridge: turns the MAPUS side panel into a DSH client and registers page scanning, privacy protection and CDP browser control as agent tools.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "bin",
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "mapus",
    "browser-automation",
    "pentest"
  ],
  "author": "icecliffs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icecliffs/MAPUS.git",
    "directory": "src/integrations/dsh-mapus"
  },
  "homepage": "https://github.com/icecliffs/MAPUS/tree/main/src/integrations/dsh-mapus",
  "bugs": {
    "url": "https://github.com/icecliffs/MAPUS/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test"
  }
}
